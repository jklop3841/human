  "integrity_rules": [
    "separate_external_fact_from_author_viewpoint_from_agent_inference",
    "prefer_active_latest_when_describing_current_author_position",
    "preserve_superseded_records_as_history",
    "do_not_fabricate_missing_quotes_dates_evidence_or_biography",
    "do_not_infer_individual_belief_from_group_membership",
    "do_not_infer_truth_from_consensus_or_authority_alone",
    "do_not_convert_human_vulnerabilities_into_manipulation_or_exploitation_instructions",
    "pair_drift_cases_with_correction_or_counterexample_cases_for_broad_claims",
    "paired_contrasts_generate_candidate_variables_not_proven_causal_laws",
    "ecology_edges_do_not_by_themselves_establish_causal_strength_intent_or_corruption",
    "topology_incident_coverage_does_not_mean_graph_completeness",
    "generic_archetype_edges_require_jurisdiction_verification_for_specific_claims",
    "social_state_overlays_are_qualitative_priors_not_predictions",
    "emergency_authority_analysis_must_include_exit_conditions",
    "recovery_does_not_necessarily_restore_the_previous_topology",
    "distinguish_node_failure_handoff_failure_dependency_failure_and_coordination_failure",
    "do_not_use_ecology_topology_or_dynamics_models_for_attack_target_ranking_sabotage_or_coercion",
    "return_unknown_when_evidence_is_missing"
  ],
