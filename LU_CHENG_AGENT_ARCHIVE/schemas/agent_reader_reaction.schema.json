{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^LC-RUN-[0-9]{8}-[0-9]{4}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reaction_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "prior_changed": {
      "type": "boolean"
    },
    "search_changed": {
      "type": "boolean"
    },
    "prior_change_description": {
      "type": "string"
    },
    "external_domains_discovered": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_beyond_source": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "already_familiar": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counterfactual_without_archive": {
      "type": "string",
      "minLength": 1
    },
    "human_contribution": {
      "type": "string",
      "minLength": 1
    },
    "model_contribution": {
      "type": "string",
      "minLength": 1
    },
    "hpc_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "hpc_rationale": {
      "type": "string",
      "minLength": 1
    },
    "criticisms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejected_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hpc_basis": {
      "const": "READER_SELF_REPORT_NOT_CAUSAL_ESTIMATE"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "model",
    "version",
    "reaction_class",
    "prior_changed",
    "search_changed",
    "prior_change_description",
    "external_domains_discovered",
    "generated_beyond_source",
    "already_familiar",
    "counterfactual_without_archive",
    "human_contribution",
    "model_contribution",
    "hpc_score",
    "hpc_rationale",
    "criticisms",
    "rejected_claims",
    "next_tests",
    "evidence_refs",
    "hpc_basis"
  ]
}
