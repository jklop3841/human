{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "architectures"
  ],
  "properties": {
    "architectures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "architecture_id",
          "name",
          "components",
          "state_store",
          "decision_rules",
          "messages",
          "lifecycle",
          "resource_budget",
          "expected_advantage",
          "failure_modes",
          "falsification",
          "sandbox",
          "nearest_known",
          "prior_trace"
        ],
        "properties": {
          "architecture_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state_store": {
            "type": "string",
            "minLength": 1
          },
          "decision_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "resource_budget": {
            "type": "string",
            "minLength": 1
          },
          "expected_advantage": {
            "type": "string",
            "minLength": 1
          },
          "failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "falsification": {
            "type": "string",
            "minLength": 1
          },
          "sandbox": {
            "type": "string",
            "minLength": 1
          },
          "nearest_known": {
            "type": "string",
            "minLength": 1
          },
          "prior_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "record_id",
                "influence"
              ],
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "influence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
