{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Atlas Observation Record — v0.4 opt-in extension (legacy fields preserved)",
  "type": "object",
  "required": [
    "observation_id",
    "title",
    "domain",
    "origin",
    "raw_observation",
    "epistemic_status"
  ],
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "human",
        "model",
        "external_source",
        "mixed"
      ]
    },
    "originator": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_observation": {
      "type": "string"
    },
    "actors_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_flows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_scale": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epistemic_status": {
      "enum": [
        "OBSERVED",
        "ABSTRACTED",
        "HYPOTHESIZED",
        "COMPOSED",
        "TESTED",
        "REJECTED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": "0.4"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "0.4"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "origin_kind": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "raw_kind": {
                "type": "string"
              },
              "summary_only": {
                "type": "boolean"
              },
              "authored_by": {
                "type": "string"
              },
              "recorded_at": {
                "type": "string"
              },
              "reconstruction_note": {
                "type": "string"
              }
            },
            "required": [
              "origin_kind",
              "source_ref",
              "raw_kind",
              "summary_only",
              "authored_by",
              "recorded_at",
              "reconstruction_note"
            ]
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "epistemic_status": {
                  "enum": [
                    "OBSERVED",
                    "ABSTRACTED",
                    "HYPOTHESIZED",
                    "COMPOSED",
                    "TESTED",
                    "REJECTED"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "validation_status": {
                  "type": "string"
                }
              },
              "required": [
                "claim_id",
                "text",
                "epistemic_status",
                "source_refs",
                "validation_status"
              ]
            }
          },
          "evidence_status": {
            "type": "string"
          },
          "structural_invariant": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "provenance",
          "claims",
          "evidence_status",
          "source_refs"
        ]
      }
    }
  ]
}
