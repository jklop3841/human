{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Atlas Architecture Species — v0.4 opt-in extension (legacy fields preserved)",
  "type": "object",
  "required": [
    "species_id",
    "name",
    "parent_prior_ids",
    "primitives",
    "interaction_rules",
    "falsification",
    "status"
  ],
  "properties": {
    "species_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "parent_prior_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interaction_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emergent_properties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nearest_known_baseline": {
      "type": [
        "string",
        "null"
      ]
    },
    "novelty_class": {
      "enum": [
        "known",
        "close_analogue",
        "unusual_composition",
        "potentially_novel",
        "unknown"
      ]
    },
    "expected_advantages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sandbox_test": {
      "type": "string"
    },
    "status": {
      "enum": [
        "HYPOTHESIZED",
        "TESTED",
        "REJECTED",
        "ARCHIVED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": "0.4"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "0.4"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "origin_kind": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "raw_kind": {
                "type": "string"
              },
              "summary_only": {
                "type": "boolean"
              },
              "authored_by": {
                "type": "string"
              },
              "recorded_at": {
                "type": "string"
              },
              "reconstruction_note": {
                "type": "string"
              }
            },
            "required": [
              "origin_kind",
              "source_ref",
              "raw_kind",
              "summary_only",
              "authored_by",
              "recorded_at",
              "reconstruction_note"
            ]
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "epistemic_status": {
                  "enum": [
                    "OBSERVED",
                    "ABSTRACTED",
                    "HYPOTHESIZED",
                    "COMPOSED",
                    "TESTED",
                    "REJECTED"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "validation_status": {
                  "type": "string"
                }
              },
              "required": [
                "claim_id",
                "text",
                "epistemic_status",
                "source_refs",
                "validation_status"
              ]
            }
          },
          "epistemic_status": {
            "enum": [
              "OBSERVED",
              "ABSTRACTED",
              "HYPOTHESIZED",
              "COMPOSED",
              "TESTED",
              "REJECTED"
            ]
          },
          "archive_status": {
            "enum": [
              "active_candidate",
              "archived",
              "deprecated"
            ]
          },
          "primitives": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true
          },
          "falsification": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "interaction_rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "emergent_properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "sandbox_test": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "schema_version",
          "provenance",
          "claims",
          "epistemic_status",
          "archive_status",
          "novelty_class",
          "nearest_known_baseline",
          "sandbox_test",
          "experiment_refs"
        ]
      }
    }
  ]
}
